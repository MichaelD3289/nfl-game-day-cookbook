{% macro anchor(label) %}[]{#{{ label|anchor }}}

{% endmacro %}
{% macro link(ref, description=true) %}[{{ ref.title|md }}]({{ route(ref.label) }}){% if ref.note %} — {{ ref.note|md }}{% endif %}{% if description and recipe_descriptions.get(ref.label) %} · {{ recipe_descriptions[ref.label]|md }}{% endif %}{% endmacro %}
{% macro ingredients(groups) %}
{% for group in groups %}
{% if group.heading %}
**{{ group.heading|md }}**
{% endif %}
{% for item in group.items %}
- {{ item.text }}{% if item.ref %} [Q]({{ route(item.ref) }}){% endif %}
{% endfor %}
{% endfor %}
{% endmacro %}
{% macro refs(entries) %}
{% for ref in entries %}
- {{ link(ref) }}
{% endfor %}
{% endmacro %}
{% macro source(src, credit='') %}
{% if src %}
**Source:** [{{ (src.title or src.display)|md }}]({{ src.href }})
{% endif %}
{% if credit %}
Photo: {{ credit }}
{% endif %}
{% endmacro %}
{% macro menu(item) %}
::: {.menu-card}
## {{ item.title|md }} {#{{ item.label|anchor }}}
{% if item.subtitle %}
*{{ item.subtitle }}*
{% endif %}
{{ refs(item.recipes) }}
{% if item.why_it_works %}
**Why it works:** {{ item.why_it_works }}
{% endif %}
{% if item.description %}
{{ item.description }}
{% endif %}
{% if item.prep_plan or item.prep_note %}
**Prep plan:** {{ item.prep_plan or item.prep_note }}
{% endif %}
:::
{% endmacro %}
