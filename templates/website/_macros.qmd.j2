{% macro anchor(label) %}<span id="{{ label|anchor|e }}"></span>

{% endmacro %}
{% macro link(ref, description=true, team=true) %}{% set meta = [ref.team if team else "", ref.course]|select|list %}<a class="dish-name" href="{{ route(ref.label)|e }}">{{ ref.title|e }}</a>{% if meta %} <span class="dish-meta">{{ meta|join(" · ")|e }}</span>{% elif ref.note %} <span class="ref-note">{{ ref.note|e }}</span>{% endif %}{% if description and descriptions.get(ref.label) %} <span class="dish-description">{{ descriptions[ref.label]|e }}</span>{% endif %}{% endmacro %}
{% macro ingredients(groups) %}
{% for group in groups %}
{% if group.heading %}
### {{ group.heading|md }}
{% endif %}
{% for item in group.items %}
- {{ item|scalable }}{% if item.ref %} <a class="q-mark" href="{{ route(item.ref)|e }}" data-carry-scale aria-label="Make {{ item.text|striptags|e }} from scratch">Q</a>{% endif %}
{% endfor %}
{% endfor %}
{% endmacro %}
{% macro scale_buttons(multipliers, label="Recipe multiplier") -%}
<span class="scaler-buttons" role="group" aria-label="{{ label|e }}">{% for label, factor in multipliers %}<button type="button" data-factor="{{ factor }}" aria-pressed="false">{{ label }}</button>{% endfor %}</span>
{%- endmacro %}
{% macro finder_filters(facets) -%}
{% for facet in facets %}
{% if facet.id == "team" %}
<fieldset data-facet="{{ facet.id|e }}">
<legend>{{ facet.title|e }}</legend>
<details>
<summary>Choose teams</summary>
{% for option in facet.options %}
<label class="finder-option"><input type="checkbox" name="{{ facet.id|e }}" value="{{ option.id|e }}"> {{ option.label|e }} <span class="finder-count"></span></label>
{% endfor %}
</details>
</fieldset>
{% else %}
<fieldset data-facet="{{ facet.id|e }}">
<legend>{{ facet.title|e }}</legend>
{% for option in facet.options %}
<label class="finder-option"><input type="checkbox" name="{{ facet.id|e }}" value="{{ option.id|e }}"> {{ option.label|e }} <span class="finder-count"></span></label>
{% endfor %}
</fieldset>
{% endif %}
{% endfor %}
{% endmacro %}
{% macro scaler(s) %}
{% if s %}

```{=html}
<div class="scaler"{% if s.servings %} data-servings="{{ s.servings }}" data-servings-max="{{ s.servings_max }}"{% endif %} hidden>
<div class="scaler-row">
<span class="scaler-label">Make</span>
{{ scale_buttons(s.multipliers) }}
{% if s.servings %}<label class="scaler-servings">or feed <input type="number" name="servings" min="1" max="500" step="1" inputmode="numeric" value="{{ s.servings }}"> people <small>(serves {{ s.serves|e }} as written)</small></label>
{% endif %}<span class="scale-status" aria-live="polite"></span>
</div>
<p class="scale-note" hidden>Ingredient amounts and the yield change. Pan sizes, temperatures and cooking times stay as written, so a bigger batch may need a second pan or more time; go by the doneness cues.</p>
</div>
<script src="scale.js"></script>
```

{% endif %}
{% endmacro %}
{% macro refs(entries, team=true, description=true, compact=false) %}
::: {.dish-list{% if compact %} .dish-list-compact{% endif %}}
{% for ref in entries %}
- {{ link(ref, description, team) }}
{% endfor %}
:::
{% endmacro %}
{% macro header(eyebrow, title, description, facts, byline="") %}
[{{ eyebrow|md }}]{.eyebrow}

# {{ title|md }}

```{=html}
{% if description %}
<p class="page-dek">{{ description|e }}</p>
{% endif %}
{% if byline %}
<p class="recipe-location">{{ byline|e }}</p>
{% endif %}
{% if facts %}
<ul class="recipe-facts">{% for name, value in facts %}{% if name == "Yield" and yield_html %}<li class="fact-yield"{% if yield_fixed %} data-fixed{% endif %}><span class="fact-name">Yield</span> {{ yield_html }}{% if yield_fixed %}<span class="yield-times"></span>{% endif %}</li>{% else %}<li><span class="fact-name">{{ name|e }}</span> {{ value|e }}</li>{% endif %}{% endfor %}</ul>
{% endif %}
```
{% endmacro %}
{% macro source(src, credit='', qr='', web=none) %}
{% if src or credit or qr %}
::: {.recipe-source}
{% if qr %}
::: {.page-qr}
<img src="{{ qr|e }}" alt="{{ 'QR code for this page' if web else 'QR code for recipe source' }}" class="source-qr">
{% if web %}
<span class="qr-caption">Scan to open on your phone</span>
{% endif %}
:::
{% endif %}
{% if src %}
**Recipe source:** <a href="{{ src.url|e }}">{{ (src.title or src.url|site_name)|e }}</a>
<span class="source-url">{{ src.display|e }}</span>
{% endif %}
{% if credit %}
Photo: {{ credit }}
{% endif %}
:::
{% endif %}
{% endmacro %}
{# Shopping list buttons for a print bar; shop.js shows them. #}
{% macro shop_actions() -%}
<span class="shop-actions" hidden><span class="shop-label">Shopping list</span><button type="button" class="shop-button" data-shop="txt">Download .txt</button><button type="button" class="shop-button" data-shop="csv">Download .csv</button><button type="button" class="shop-button" data-shop="copy">Copy</button><span class="shop-status" aria-live="polite"></span></span>
{%- endmacro %}

{% macro print_menu(item) %}
{% if item.get("print_pages") %}

```{=html}
<div class="print-bar print-menu" hidden data-print-pages="{{ item.print_pages|join(" ")|e }}"{% if item.get("print_components") %} data-print-components="{{ item.print_components|join(" ")|e }}"{% endif %}><button type="button" class="print-button">Print menu + recipes</button>{% if item.get("print_components") %}<label class="print-with" hidden><input type="checkbox" name="print-with"> Include homemade components</label>{% endif %}{{ shop_actions() }}</div>
```

{% endif %}
{% endmacro %}
{% macro menu(item) %}
::: {.menu-card}
{{ anchor(item.label) }}
## {{ item.title|md }}
{% if item.subtitle %}
[{{ item.subtitle|md }}]{.menu-matchup}
{% endif %}
{{ refs(item.recipes) }}
{{ print_menu(item) }}
{% if item.why_it_works %}
### Why it works
{{ item.why_it_works }}
{% endif %}
{% if item.description %}
{{ item.description }}
{% endif %}
{% if item.prep_plan or item.prep_note %}
### Prep plan
{{ item.prep_plan or item.prep_note }}
{% endif %}
:::
{% endmacro %}
{% macro print_button(scaled=false, pages=(), shop=false) %}

```{=html}
<div class="print-bar" hidden{% if pages %} data-print-pages="{{ pages|join(" ")|e }}"{% endif %}><button type="button" class="print-button">Print</button>{% if pages %}<label class="print-with" hidden><input type="checkbox" name="print-with"> Include homemade components</label>{% endif %}{% if shop %}{{ shop_actions() }}{% endif %}</div>
{% if scaled %}
<p class="print-scale" hidden></p>
{% endif %}
```

{% endmacro %}
{% macro suggest(s, compact=false) %}

```{=html}
<div class="suggest{% if compact %} suggest-compact{% endif %}" data-kind="{{ s.kind|e }}" data-fields="{{ s.fields|e }}">
<span class="suggest-lead">{{ s.lead|e }}</span>
<span class="suggest-actions"><a class="suggest-github" href="{{ s.github|e }}" target="_blank" rel="noopener">Suggest on GitHub</a>{% if suggestion_form_url %}<button type="button" class="suggest-open" data-endpoint="{{ suggestion_form_url|e }}" hidden>Suggest without an account</button>{% endif %}</span>
</div>
```

{% endmacro %}
