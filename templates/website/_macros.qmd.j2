{% macro anchor(label) %}<span id="{{ label|anchor|e }}"></span>

{% endmacro %}
{% macro link(ref, description=true) %}<a href="{{ route(ref.label)|e }}">{{ ref.title|e }}</a>{% if ref.note %} <span class="ref-note">{{ ref.note|e }}</span>{% endif %}{% if description and recipe_descriptions.get(ref.label) %} <span class="dish-description">{{ recipe_descriptions[ref.label]|e }}</span>{% endif %}{% endmacro %}
{% macro ingredients(groups) %}
{% for group in groups %}
{% if group.heading %}
### {{ group.heading|md }}
{% endif %}
{% for item in group.items %}
- {{ item|scalable }}{% if item.ref %} <a class="q-mark" href="{{ route(item.ref)|e }}" data-carry-scale aria-label="Make {{ item.text|striptags|e }} from scratch">Q</a>{% endif %}
{% endfor %}
{% endfor %}
{% endmacro %}
{% macro scaler(s) %}
{% if s %}

```{=html}
<div class="scaler"{% if s.servings %} data-servings="{{ s.servings }}" data-servings-max="{{ s.servings_max }}"{% endif %} hidden>
<div class="scaler-row">
<span class="scaler-label">Make</span>
<span class="scaler-buttons" role="group" aria-label="Recipe multiplier">{% for label, factor in s.multipliers %}<button type="button" data-factor="{{ factor }}" aria-pressed="false">{{ label }}</button>{% endfor %}</span>
{% if s.servings %}<label class="scaler-servings">or feed <input type="number" name="servings" min="1" max="500" step="1" inputmode="numeric" value="{{ s.servings }}"> people <small>(serves {{ s.serves|e }} as written)</small></label>
{% endif %}<span class="scale-status" aria-live="polite"></span>
</div>
<p class="scale-note" hidden>Only ingredient amounts change. Pan sizes, temperatures and cooking times stay as written, so a bigger batch may need a second pan or more time; go by the doneness cues.</p>
</div>
<script src="scale.js"></script>
```

{% endif %}
{% endmacro %}
{% macro refs(entries) %}
{% for ref in entries %}
- {{ link(ref) }}
{% endfor %}
{% endmacro %}
{% macro source(src, credit='', qr='', web=none) %}
{% if src or credit or qr %}
::: {.recipe-source}
{% if qr %}
::: {.page-qr}
<img src="{{ qr|e }}" alt="{{ 'QR code for this page' if web else 'QR code for recipe source' }}" class="source-qr">
{% if web %}
<span class="qr-caption">Scan to open on your phone</span>
{% endif %}
:::
{% endif %}
{% if src %}
**Recipe source:** <a href="{{ src.href|e }}">{{ (src.title or src.display)|e }}</a>  
<small>{{ src.display|e }}</small>
{% endif %}
{% if credit %}
Photo: {{ credit }}
{% endif %}
:::
{% endif %}
{% endmacro %}
{% macro menu(item) %}
::: {.menu-card}
{{ anchor(item.label) }}
## {{ item.title|md }}
{% if item.subtitle %}
{{ item.subtitle }}
{% endif %}
{{ refs(item.recipes) }}
{% if item.why_it_works %}
### Why it works
{{ item.why_it_works }}
{% endif %}
{% if item.description %}
{{ item.description }}
{% endif %}
{% if item.prep_plan or item.prep_note %}
### Prep plan
{{ item.prep_plan or item.prep_note }}
{% endif %}
:::
{% endmacro %}
{% macro print_button(scaled=false) %}

```{=html}
<div class="print-bar" hidden><button type="button" class="print-button">Print</button></div>
{% if scaled %}
<p class="print-scale" hidden></p>
{% endif %}
```

{% endmacro %}
{% macro suggest(s, compact=false) %}

```{=html}
<div class="suggest{% if compact %} suggest-compact{% endif %}" data-kind="{{ s.kind|e }}" data-fields="{{ s.fields|e }}">
<span class="suggest-lead">{{ s.lead|e }}</span>
<span class="suggest-actions"><a class="suggest-github" href="{{ s.github|e }}" target="_blank" rel="noopener">Suggest on GitHub</a>{% if suggestion_form_url %}<button type="button" class="suggest-open" data-endpoint="{{ suggestion_form_url|e }}" hidden>Suggest without an account</button>{% endif %}</span>
</div>
```

{% endmacro %}
